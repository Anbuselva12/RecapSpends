        "repeat",
        "reminder",
        "categoryId",
        "subcategory",
        "iconKey",
        "autopay",
        "paid",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedCategory": {
      "title": "SharedCategory",
      "description": "Category and subcategory set shared into a family workspace while creator and members are active in the workspace.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "sourceCategoryId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "memberIds": { "type": "array" },
        "name": { "type": "string" },
        "iconKey": { "type": "string" },
        "colorIndex": { "type": "integer" },
        "subcategories": { "type": "array" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
