{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences, budget settings, optional shared workspace membership, contributed workspace IDs, and sample-data seed status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID" },
        "monthlyBudget": { "type": "number", "description": "Monthly spending budget in INR" },
        "language": { "type": "string", "enum": ["en", "ta"], "description": "UI language code" },
        "seeded": { "type": "boolean", "description": "Whether initial sample data has been seeded" },
        "displayName": { "type": "string", "description": "Optional display name" },
        "workspaceId": { "type": "string", "description": "Optional joined shared family workspace ID" },
        "contributedWorkspaceIds": { "type": "array", "description": "Workspace IDs where user contributed to another member's shared vehicle or project" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "monthlyBudget", "language", "seeded", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Customizable expense category with icon, color token index, subcategories, and optional workspace visibility.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "iconKey": { "type": "string" },
        "colorIndex": { "type": "integer" },
        "subcategories": { "type": "array" },
        "sortOrder": { "type": "integer" },
        "hiddenFromWorkspace": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "iconKey", "colorIndex", "subcategories", "sortOrder", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Individual expense entry with optional GST invoice metadata, privacy flag, and item-level breakdown.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "dateEpochMs": { "type": "integer" },
        "categoryId": { "type": "string" },
        "subcategory": { "type": "string" },
        "paymentMode": { "type": "string", "enum": ["UPI", "Cash", "Card", "Bank"] },
        "entryType": { "type": "string", "enum": ["expense", "income"] },
        "isPrivate": { "type": "boolean" },
        "projectId": { "type": "string" },
        "vehicleId": { "type": "string" },
        "gstin": { "type": "string" },
        "billNumber": { "type": "string" },
        "taxableValue": { "type": "number" },
        "cgst": { "type": "number" },
        "sgst": { "type": "number" },
        "igst": { "type": "number" },
        "roundOff": { "type": "number" },
        "items": { "type": "array" },
        "attachmentNotes": { "type": "array" },
        "odometerReading": { "type": "integer" },
        "fuelPricePerLitre": { "type": "number" },
        "fuelLitres": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "amount", "dateEpochMs", "categoryId", "subcategory", "paymentMode", "createdAt", "updatedAt"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Tracked vehicle with odometer, mileage, service checklist items, visit history, and workspace visibility.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "type": { "type": "string", "enum": ["bike", "car"] },
        "plate": { "type": "string" },
        "odometer": { "type": "integer" },
        "avgMileage": { "type": "number" },
        "items": { "type": "array" },
        "history": { "type": "array" },
        "hiddenFromWorkspace": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "shortName", "type", "plate", "odometer", "avgMileage", "items", "history", "createdAt", "updatedAt"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Recurring or one-off bill reminder with due date, repeat schedule, paid status, and workspace visibility.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "dueEpochMs": { "type": "integer" },
        "repeat": { "type": "string", "enum": ["Once", "Monthly", "Bi-monthly", "Half-yearly", "Yearly"] },
        "reminder": { "type": "string", "enum": ["On the day", "3 days before", "7 days before"] },
        "categoryId": { "type": "string" },
        "subcategory": { "type": "string" },
        "iconKey": { "type": "string" },
        "autopay": { "type": "boolean" },
        "paid": { "type": "boolean" },
        "paidOnEpochMs": { "type": "integer" },
        "hiddenFromWorkspace": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "amount", "dueEpochMs", "repeat", "reminder", "categoryId", "subcategory", "iconKey", "autopay", "paid", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Long-running project (house build, business setup, renovation) with phase budgets, vendors, and workspace visibility.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "iconKey": { "type": "string" },
        "colorIndex": { "type": "integer" },
        "budget": { "type": "number" },
        "phases": { "type": "array" },
        "vendors": { "type": "array" },
        "payments": { "type": "array" },
        "productCatalog": { "type": "array" },
        "hiddenFromWorkspace": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "subtitle", "iconKey", "colorIndex", "budget", "phases", "vendors", "payments", "createdAt", "updatedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Shared family workspace linking members who share selected expenses, vehicles, projects, bills, and categories.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "inviteCode": { "type": "string" },
        "memberIds": { "type": "array" },
        "members": { "type": "object" },
        "lastJoinCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerUid", "inviteCode", "memberIds", "members", "createdAt", "updatedAt"]
    },
    "WorkspaceInvite": {
      "title": "WorkspaceInvite",
      "description": "Invite token document mapping a short invite code to a shared family workspace.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "workspaceName": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "workspaceName", "ownerUid", "ownerName", "createdAt"]
    },
    "SharedExpense": {
      "title": "SharedExpense",
      "description": "Non-private expense shared into a family workspace; retained read-only for the contributor only if linked to a foreign vehicle/project upon departure.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "sourceExpenseId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "memberIds": { "type": "array" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "dateEpochMs": { "type": "integer" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "categoryIconKey": { "type": "string" },
        "categoryColorIndex": { "type": "integer" },
        "subcategory": { "type": "string" },
        "paymentMode": { "type": "string", "enum": ["UPI", "Cash", "Card", "Bank"] },
        "entryType": { "type": "string", "enum": ["expense", "income"] },
        "sharedVehicleId": { "type": "string" },
        "sharedVehicleOwnerUid": { "type": "string" },
        "sharedProjectId": { "type": "string" },
        "sharedProjectOwnerUid": { "type": "string" },
        "odometerReading": { "type": "integer" },
        "fuelPricePerLitre": { "type": "number" },
        "fuelLitres": { "type": "number" },
        "retainedForDeparture": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId",
        "sourceExpenseId",
        "ownerUid",
        "ownerName",
        "memberIds",
        "title",
        "amount",
        "dateEpochMs",
        "categoryId",
        "categoryName",
        "categoryIconKey",
        "categoryColorIndex",
        "subcategory",
        "paymentMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedVehicle": {
      "title": "SharedVehicle",
      "description": "Vehicle shared into a family workspace; contributors retain read-only visibility after leaving or removal.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "sourceVehicleId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "memberIds": { "type": "array" },
        "contributorIds": { "type": "array" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "type": { "type": "string", "enum": ["bike", "car"] },
        "plate": { "type": "string" },
        "odometer": { "type": "integer" },
        "avgMileage": { "type": "number" },
        "items": { "type": "array" },
        "history": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId",
        "sourceVehicleId",
        "ownerUid",
        "ownerName",
        "memberIds",
        "contributorIds",
        "name",
        "shortName",
        "type",
        "plate",
        "odometer",
        "avgMileage",
        "items",
        "history",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedProject": {
      "title": "SharedProject",
      "description": "Project shared into a family workspace; contributors retain read-only visibility after leaving or removal.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "sourceProjectId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "memberIds": { "type": "array" },
        "contributorIds": { "type": "array" },
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "iconKey": { "type": "string" },
        "colorIndex": { "type": "integer" },
        "budget": { "type": "number" },
        "phases": { "type": "array" },
        "vendors": { "type": "array" },
        "payments": { "type": "array" },
        "productCatalog": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId",
        "sourceProjectId",
        "ownerUid",
        "ownerName",
        "memberIds",
        "contributorIds",
        "name",
        "subtitle",
        "iconKey",
        "colorIndex",
        "budget",
        "phases",
        "vendors",
        "payments",
        "productCatalog",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedProjectContribution": {
      "title": "SharedProjectContribution",
      "description": "Workspace member payment or itemized contribution to a shared project.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "sharedProjectId": { "type": "string" },
        "projectOwnerUid": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "memberIds": { "type": "array" },
        "retainedForDeparture": { "type": "boolean" },
        "dateEpochMs": { "type": "integer" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "vendor": { "type": "string" },
        "phaseName": { "type": "string" },
        "items": { "type": "array" },
        "linkedExpenseId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId",
        "sharedProjectId",
        "projectOwnerUid",
        "ownerUid",
        "ownerName",
        "memberIds",
        "dateEpochMs",
        "title",
        "amount",
        "vendor",
        "phaseName",
        "items",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedBill": {
      "title": "SharedBill",
      "description": "Bill reminder shared into a family workspace while creator and members are active in the workspace.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "sourceBillId": { "type": "string" },
        "ownerUid": { "type": "string" },
