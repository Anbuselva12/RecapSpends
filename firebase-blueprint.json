  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and settings document"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "User expense categories"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "User expenses and scanned GST bills"
    },
    "/users/{userId}/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "User vehicles and maintenance checklists"
    },
    "/users/{userId}/bills/{billId}": {
      "schema": { "$ref": "#/entities/Bill" },
      "description": "User recurring and one-off bills"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "User projects, phases, vendors, and payments"
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Shared family workspace metadata and member roster"
    },
    "/workspaces/{workspaceId}/expenses/{sharedExpenseId}": {
      "schema": { "$ref": "#/entities/SharedExpense" },
      "description": "Shared expenses visible to current workspace members (or retained read-only for departed contributors)"
    },
    "/workspaces/{workspaceId}/vehicles/{sharedVehicleId}": {
      "schema": { "$ref": "#/entities/SharedVehicle" },
      "description": "Shared vehicles visible to workspace members and retained read-only for past contributors"
    },
    "/workspaces/{workspaceId}/projects/{sharedProjectId}": {
      "schema": { "$ref": "#/entities/SharedProject" },
      "description": "Shared projects visible to workspace members and retained read-only for past contributors"
    },
    "/workspaces/{workspaceId}/projectContributions/{contributionId}": {
      "schema": { "$ref": "#/entities/SharedProjectContribution" },
      "description": "Contributions by workspace members to shared projects"
    },
    "/workspaces/{workspaceId}/bills/{sharedBillId}": {
      "schema": { "$ref": "#/entities/SharedBill" },
      "description": "Shared bill reminders visible to current workspace members"
    },
    "/workspaces/{workspaceId}/categories/{sharedCategoryId}": {
      "schema": { "$ref": "#/entities/SharedCategory" },
      "description": "Shared categories and subcategories visible to current workspace members"
    },
    "/workspaceInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/WorkspaceInvite" },
      "description": "Invite lookup tokens for joining a family workspace"
    }
  }
}
